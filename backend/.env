PORT=5000
NODE_ENV=development
JWT_SECRET=civicchain_super_secret_jwt_key_2024_change_in_production
JWT_EXPIRES_IN=7d

# Database
DB_PATH=./data/civicchain.db

# File uploads
UPLOAD_PATH=../uploads
MAX_FILE_SIZE=10485760

# Blockchain mode: mock | fabric
BLOCKCHAIN_MODE=mock

# Fabric config (used when BLOCKCHAIN_MODE=fabric)
FABRIC_CHANNEL_NAME=mychannel
FABRIC_CHAINCODE_NAME=civicchain
FABRIC_MSP_ID=Org1MSP
FABRIC_PEER_ENDPOINT=localhost:7051
FABRIC_TLS_CERT_PATH=../blockchain/network/organizations/peerOrganizations/org1.example.com/tlsca/tlsca.org1.example.com-cert.pem
FABRIC_WALLET_PATH=./wallet

# CORS
FRONTEND_URL=http://localhost:5173

# Bcrypt
BCRYPT_ROUNDS=12
